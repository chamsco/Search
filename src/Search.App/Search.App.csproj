<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Search.App</RootNamespace>
    <AssemblyName>Search</AssemblyName>
    <ApplicationIcon>Assets\Search.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.19</Version>
    <Product>Search</Product>
    <Company>Search for Windows (port of Office Commun's Search)</Company>
    <Description>Search, a browser with nothing in the way. Windows port.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Search.Core/Search.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Search's own pages (history, bookmarks, downloads, settings), served to the engine from search.internal. -->
    <Content Include="Pages\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Search.png" />
    <Resource Include="Assets\Search.ico" />
  </ItemGroup>
</Project>
