<Window x:Class="Search.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Search.App"
        xmlns:core="clr-namespace:Search.Core;assembly=Search.Core"
        Title="Search" Width="1280" Height="860" MinWidth="520" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Frame}"
        FontFamily="{StaticResource Text}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Assets/Search.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <local:VisibleWhen x:Key="Visible" />
    <local:VisibleUnless x:Key="Hidden" />

    <!-- A door: the column's quiet glyph buttons (back, forward, reload, the window's own). -->
    <Style x:Key="Door" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Foreground" Value="{DynamicResource Row.Muted}" />
      <Setter Property="FontFamily" Value="{StaticResource Glyphs}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Row.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Row.Wash}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Row.Faint}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseDoor" TargetType="Button" BasedOn="{StaticResource Door}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Close.Hover}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Motion.quick: hovers fade in and out rather than snapping. -->
    <Storyboard x:Key="HoverIn"><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard>
    <!-- The page on screen: its row takes the wash and lets it go over a moment. -->
    <Storyboard x:Key="WashIn"><DoubleAnimation Storyboard.TargetName="WashLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" /></Storyboard>
    <Storyboard x:Key="WashOut"><DoubleAnimation Storyboard.TargetName="WashLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard>
    <Storyboard x:Key="HoverOut"><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" /></Storyboard>
    <!-- A row arriving (a new tab, a reopened one) slides down into place and fades in. -->
    <Storyboard x:Key="Arrive">
      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-6" To="0" Duration="0:0:0.22">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>

    <!-- The site's icon, or its letter until a visit brings one (Icons.swift Mark). -->
    <DataTemplate x:Key="Mark" DataType="{x:Type local:Tab}">
      <Grid Width="15" Height="15">
        <Image Source="{Binding Icon}" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Glyphs}" FontSize="12" Foreground="{DynamicResource Row.Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasGlyph, Converter={StaticResource Visible}}" />
        <Border CornerRadius="3.3" Background="{DynamicResource Mark.Fill}"
                Visibility="{Binding ShowsLetter, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding Monogram}" FontSize="8.4" FontWeight="Medium" Foreground="{DynamicResource Ink}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </DataTemplate>

    <!-- Loading: a quarter-turn arc going round, where the cross sits. -->
    <ControlTemplate x:Key="Ring" TargetType="ContentControl">
      <Path Width="12" Height="12" Stroke="{DynamicResource Row.Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M6,0.75 A5.25,5.25 0 0 1 11.25,6" RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform><RotateTransform x:Name="Spin" /></Path.RenderTransform>
        <Path.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Path.Triggers>
      </Path>
    </ControlTemplate>

    <!-- A tab's row in the column (Side.swift TabRow): 28 tall, corners of 9. -->
    <DataTemplate x:Key="TabRow" DataType="{x:Type local:Tab}">
      <Border x:Name="Row" AutomationProperties.Name="{Binding Label}" Height="28" CornerRadius="9" Background="Transparent" Margin="{Binding Indent}"
              MouseLeftButtonDown="Row_MouseDown" MouseUp="Row_MouseUp" ContextMenuOpening="Row_ContextMenuOpening"
              AllowDrop="True" Drop="Row_Drop" DragOver="Row_DragOver">
        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="Loaded"><BeginStoryboard Storyboard="{StaticResource Arrive}" /></EventTrigger>
        </Border.Triggers>
        <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
        <Grid>
        <Border x:Name="WashLayer" CornerRadius="9" Background="{DynamicResource Row.Wash}" Opacity="0" />
        <Border x:Name="HoverLayer" CornerRadius="9" Background="{DynamicResource Row.Hover}" Opacity="0" />
        <Grid Margin="10,0,7,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentPresenter x:Name="MarkHost" Content="{Binding}" ContentTemplate="{StaticResource Mark}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Row.Muted}" />
          <Button x:Name="CopyLink" Grid.Column="2" Style="{StaticResource Door}" Width="15" Height="15" Margin="8,0,0,0" FontSize="9" Content="&#xE8C8;"
                  Visibility="Collapsed" Click="CopyRowLink_Click" ToolTip="Copy link" AutomationProperties.Name="Copy link" />
          <TextBox x:Name="Field" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" FontSize="12.5" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" VerticalContentAlignment="Center" Padding="-2,0,0,0"
                   PreviewKeyDown="InlineField_PreviewKeyDown" TextChanged="InlineField_TextChanged" LostKeyboardFocus="InlineField_LostFocus" />
          <Grid Grid.Column="3" Width="15" Height="15" Margin="8,0,0,0">
            <ContentControl x:Name="Ring" Template="{StaticResource Ring}" Visibility="Collapsed" />
            <Button x:Name="Close" Style="{StaticResource Door}" Width="15" Height="15" Margin="0" FontSize="8" Content="&#xE8BB;"
                    Visibility="Hidden" Click="CloseTab_Click" ToolTip="Close tab (Ctrl+W)" />
          </Grid>
        </Grid>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsBlank}" Value="True">
          <Setter TargetName="MarkHost" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Loading}" Value="True">
          <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
          <Setter TargetName="Close" Property="Visibility" Value="Visible" />
          <Setter TargetName="CopyLink" Property="Visibility" Value="Visible" />
          <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
        </Trigger>
        <DataTrigger Binding="{Binding InSplit}" Value="True">
          <Setter TargetName="Row" Property="BorderThickness" Value="1" />
          <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Row.Wash}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Live}" Value="True">
          <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource WashIn}" /></DataTrigger.EnterActions>
          <DataTrigger.ExitActions><BeginStoryboard Storyboard="{StaticResource WashOut}" /></DataTrigger.ExitActions>
          <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Ink}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Editing}" Value="True">
          <Setter TargetName="Field" Property="Visibility" Value="Visible" />
          <Setter TargetName="Title" Property="Visibility" Value="Hidden" />
          <Setter TargetName="MarkHost" Property="Visibility" Value="Hidden" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The same row, laid along the top strip (Settings › Tabs › Layout: Top). -->
    <DataTemplate x:Key="TabChip" DataType="{x:Type local:Tab}">
      <Border x:Name="Row" AutomationProperties.Name="{Binding Label}" Width="172" Height="30" CornerRadius="9" Background="Transparent" Margin="0,0,2,0" WindowChrome.IsHitTestVisibleInChrome="True"
              MouseLeftButtonDown="Row_MouseDown" MouseUp="Row_MouseUp" ContextMenuOpening="Row_ContextMenuOpening"
              AllowDrop="True" Drop="Row_Drop" DragOver="Row_DragOver">
        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="Loaded"><BeginStoryboard Storyboard="{StaticResource Arrive}" /></EventTrigger>
        </Border.Triggers>
        <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
        <Grid>
        <Border x:Name="WashLayer" CornerRadius="9" Background="{DynamicResource Row.Wash}" Opacity="0" />
        <Border x:Name="HoverLayer" CornerRadius="9" Background="{DynamicResource Row.Hover}" Opacity="0" />
        <Grid Margin="10,0,7,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentPresenter x:Name="MarkHost" Content="{Binding}" ContentTemplate="{StaticResource Mark}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Row.Muted}" />
          <TextBox x:Name="Field" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" FontSize="12.5" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" VerticalContentAlignment="Center" Padding="-2,0,0,0"
                   PreviewKeyDown="InlineField_PreviewKeyDown" TextChanged="InlineField_TextChanged" LostKeyboardFocus="InlineField_LostFocus" />
          <Grid Grid.Column="2" Width="15" Height="15" Margin="8,0,0,0">
            <ContentControl x:Name="Ring" Template="{StaticResource Ring}" Visibility="Collapsed" />
            <Button x:Name="Close" Style="{StaticResource Door}" Width="15" Height="15" Margin="0" FontSize="8" Content="&#xE8BB;"
                    Visibility="Hidden" Click="CloseTab_Click" ToolTip="Close tab (Ctrl+W)" />
          </Grid>
        </Grid>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsBlank}" Value="True">
          <Setter TargetName="MarkHost" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Loading}" Value="True">
          <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
          <Setter TargetName="Close" Property="Visibility" Value="Visible" />
          <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
        </Trigger>
        <DataTrigger Binding="{Binding InSplit}" Value="True">
          <Setter TargetName="Row" Property="BorderThickness" Value="1" />
          <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Row.Wash}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Live}" Value="True">
          <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource WashIn}" /></DataTrigger.EnterActions>
          <DataTrigger.ExitActions><BeginStoryboard Storyboard="{StaticResource WashOut}" /></DataTrigger.ExitActions>
          <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Ink}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Editing}" Value="True">
          <Setter TargetName="Field" Property="Visibility" Value="Visible" />
          <Setter TargetName="Title" Property="Visibility" Value="Hidden" />
          <Setter TargetName="MarkHost" Property="Visibility" Value="Hidden" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A pin: a square under the lights, 34 tall, the site's icon in the middle. -->
    <DataTemplate x:Key="PinTile" DataType="{x:Type local:Tab}">
      <Border x:Name="Tile" Height="34" WindowChrome.IsHitTestVisibleInChrome="True" CornerRadius="9" Margin="2" Background="{DynamicResource Row.Tile}"
              MouseLeftButtonDown="Row_MouseDown" MouseUp="Row_MouseUp" ContextMenuOpening="Row_ContextMenuOpening" ToolTip="{Binding Label}"
              AllowDrop="True" Drop="Row_Drop" DragOver="Row_DragOver">
        <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
        <Grid>
        <Border x:Name="HoverLayer" CornerRadius="9" Background="{DynamicResource Row.Wash}" Opacity="0" />
        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                 Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Glyphs}" FontSize="13" Foreground="{DynamicResource Ink}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasGlyph, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding Monogram}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource Ink}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding ShowsLetter, Converter={StaticResource Visible}}" />
        </Grid>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
        </Trigger>
        <DataTrigger Binding="{Binding Live}" Value="True">
          <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Row.PinLive}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A post of a live folder: a line that opens its page. -->
    <DataTemplate x:Key="FeedLine" DataType="{x:Type local:FeedRow}">
      <Border x:Name="Post" AutomationProperties.Name="{Binding Title}" Height="28" CornerRadius="8" Background="Transparent" Margin="{Binding Indent}" ToolTip="{Binding Title}"
              MouseLeftButtonDown="FeedRow_MouseDown">
        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis" />
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Post" Property="IsMouseOver" Value="True">
          <Setter TargetName="Post" Property="Background" Value="{DynamicResource Row.Hover}" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A group's name, or a folder among the pinned rows, as a line above what it holds (TabGroups.swift, PinFolderViews.swift). -->
    <DataTemplate x:Key="HeadingRow" DataType="{x:Type local:RowHeading}">
      <Border x:Name="Head" AutomationProperties.Name="{Binding Name}" Height="24" CornerRadius="8" Background="Transparent" Margin="{Binding Indent}"
              MouseLeftButtonDown="Heading_MouseDown" ContextMenuOpening="Heading_ContextMenuOpening" AllowDrop="True" Drop="Heading_Drop" DragOver="Heading_DragOver">
        <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
        <Grid Margin="8,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Mark}" FontFamily="{StaticResource Glyphs}" FontSize="8" Foreground="{DynamicResource Row.Muted}" VerticalAlignment="Center" Margin="0,0,7,0" />
          <Border Grid.Column="1" x:Name="Stripe" Width="4" Height="12" CornerRadius="2" Background="{Binding Stripe}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock x:Name="Name" Grid.Column="2" Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Row.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBox x:Name="HeadField" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" FontSize="11.5" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" VerticalContentAlignment="Center" Padding="-2,0,0,0"
                   PreviewKeyDown="HeadField_PreviewKeyDown" LostKeyboardFocus="HeadField_LostFocus" />
          <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="10.5" Foreground="{DynamicResource Row.Muted}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Head" Property="IsMouseOver" Value="True">
          <Setter TargetName="Head" Property="Background" Value="{DynamicResource Row.Hover}" />
        </Trigger>
        <DataTrigger Binding="{Binding Stripe}" Value="{x:Null}">
          <Setter TargetName="Stripe" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Editing}" Value="True">
          <Setter TargetName="HeadField" Property="Visibility" Value="Visible" />
          <Setter TargetName="Name" Property="Visibility" Value="Hidden" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The same, along the top strip. -->
    <DataTemplate x:Key="HeadingChip" DataType="{x:Type local:RowHeading}">
      <Border x:Name="Head" AutomationProperties.Name="{Binding Name}" Height="30" CornerRadius="9" Background="Transparent" Margin="0,0,2,0" Padding="9,0,9,0" WindowChrome.IsHitTestVisibleInChrome="True"
              MouseLeftButtonDown="Heading_MouseDown" ContextMenuOpening="Heading_ContextMenuOpening">
        <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="Stripe" Width="4" Height="12" CornerRadius="2" Background="{Binding Stripe}" Margin="0,0,6,0" />
          <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Row.Muted}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
          <TextBox x:Name="HeadField" Visibility="Collapsed" MinWidth="80" FontSize="11.5" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" PreviewKeyDown="HeadField_PreviewKeyDown" LostKeyboardFocus="HeadField_LostFocus" />
          <TextBlock Text="{Binding Mark}" FontFamily="{StaticResource Glyphs}" FontSize="8" Foreground="{DynamicResource Row.Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Head" Property="IsMouseOver" Value="True">
          <Setter TargetName="Head" Property="Background" Value="{DynamicResource Row.Hover}" />
        </Trigger>
        <DataTrigger Binding="{Binding Stripe}" Value="{x:Null}">
          <Setter TargetName="Stripe" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Editing}" Value="True">
          <Setter TargetName="HeadField" Property="Visibility" Value="Visible" />
          <Setter TargetName="Name" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A row under the field (Omnibox.swift Row): address in ink, title muted. -->
    <DataTemplate x:Key="Offer" DataType="{x:Type core:Suggestion}">
      <Border x:Name="B" CornerRadius="9" Padding="12,9" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Offer_Click">
        <DockPanel LastChildFill="True">
          <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Width="14" Margin="0,0,8,0" FontFamily="{StaticResource Glyphs}" FontSize="11"
                     Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Text="&#xE71B;" />
          <TextBlock x:Name="Key" DockPanel.Dock="Left" Text="{Binding Key}" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Search">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE721;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Open">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE8A7;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Visited">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE81C;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Known">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE774;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Suggested">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE721;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
          <Setter TargetName="B" Property="Background" Value="{DynamicResource Wash}" />
        </DataTrigger>
        <Trigger SourceName="B" Property="IsMouseOver" Value="True">
          <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="OfferList" TargetType="ListBox">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="ItemTemplate" Value="{StaticResource Offer}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Sheet" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Ground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SideColumn" Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Tabs along the top: the window's doors, the spaces, pins, tabs and the foot's doors in one strip. -->
    <Grid x:Name="TopBar" Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="0" Height="46" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="10,0,8,0" VerticalAlignment="Center">
        <Button Style="{StaticResource CloseDoor}" Content="&#xE8BB;" FontSize="9" Click="CloseWindow_Click" ToolTip="Close" />
        <Button Style="{StaticResource Door}" Content="&#xE921;" FontSize="9" Click="Minimize_Click" ToolTip="Minimize" />
        <Button Style="{StaticResource Door}" x:Name="TopMaxDoor" Content="&#xE922;" FontSize="9" Click="Maximize_Click" ToolTip="Maximize" />
        <Border Width="8" />
        <Button Style="{StaticResource Door}" x:Name="TopBackDoor" Content="&#xE76B;" Click="Back_Click" ToolTip="Back (Alt+Left)" />
        <Button Style="{StaticResource Door}" x:Name="TopForwardDoor" Content="&#xE76C;" Click="Forward_Click" ToolTip="Forward (Alt+Right)" />
        <Button Style="{StaticResource Door}" x:Name="TopReloadDoor" Content="&#xE72C;" FontSize="10" Click="Reload_Click" ToolTip="Reload (Ctrl+R)" />
      </StackPanel>
      <ScrollViewer x:Name="TopScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" PreviewMouseWheel="TopScroll_Wheel">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel x:Name="TopSpaceStrip" Orientation="Horizontal" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True" />
          <ItemsControl x:Name="TopPins" ItemTemplate="{StaticResource PinTile}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Width" Value="40" /></Style></ItemsControl.ItemContainerStyle>
          </ItemsControl>
          <ItemsControl x:Name="TopTabs" ItemTemplate="{StaticResource TabChip}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border Width="30" Height="30" CornerRadius="9" Background="Transparent" Cursor="Arrow" ToolTip="New Tab (Ctrl+T)" WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="NewTab_Click">
            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyphs}" FontSize="11" Foreground="{DynamicResource Row.Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,10,0" VerticalAlignment="Center">
        <Button Style="{StaticResource Door}" x:Name="TopUpdateDoor" Content="&#xE895;" ToolTip="Restart to Update" Click="TopUpdate_Click" Visibility="Collapsed" />
        <Button Style="{StaticResource Door}" Content="&#xE80F;" ToolTip="Home" Click="Home_Click" />
        <Button Style="{StaticResource Door}" x:Name="TopDownloadsDoor" Content="&#xE896;" ToolTip="Downloads (Ctrl+Shift+J)" Click="DownloadsDoor_Click" />
        <Button Style="{StaticResource Door}" x:Name="TopLibraryDoor" Content="&#xE8F1;" ToolTip="Library (Ctrl+Shift+L)" Click="LibraryDoor_Click" />
        <Button Style="{StaticResource Door}" x:Name="TopProfileDoor" AutomationProperties.AutomationId="ProfileDoor" Content="&#xE77B;" ToolTip="Profiles" Click="ProfileDoor_Click" Visibility="Collapsed" />
      </StackPanel>
    </Grid>

    <!-- The column -->
    <DockPanel x:Name="Side" Grid.Column="0" Grid.RowSpan="3">
      <!-- The strip: the window's own doors where the Mac has its lights, in the lights' order (close, minimise, zoom), then back, forward and reload. -->
      <Grid DockPanel.Dock="Top" Height="52">
        <Button Style="{StaticResource Door}" x:Name="CollapseDoor" AutomationProperties.AutomationId="CollapseSidebar" AutomationProperties.Name="Hide sidebar" Content="&#xE89F;" FontSize="11" HorizontalAlignment="Right" Margin="0,0,10,0" Click="CollapseDoor_Click" ToolTip="Hide sidebar (Ctrl+Shift+S)" />
        <StackPanel x:Name="SideDoors" Orientation="Horizontal" Margin="10,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Button Style="{StaticResource CloseDoor}" Content="&#xE8BB;" FontSize="9" Click="CloseWindow_Click" ToolTip="Close" />
          <Button Style="{StaticResource Door}" Content="&#xE921;" FontSize="9" Click="Minimize_Click" ToolTip="Minimize" />
          <Button Style="{StaticResource Door}" x:Name="MaxDoor" Content="&#xE922;" FontSize="9" Click="Maximize_Click" ToolTip="Maximize" />
          <Border Width="8" />
          <Button Style="{StaticResource Door}" x:Name="BackDoor" Content="&#xE76B;" Click="Back_Click" ToolTip="Back (Alt+Left)" />
          <Button Style="{StaticResource Door}" x:Name="ForwardDoor" Content="&#xE76C;" Click="Forward_Click" ToolTip="Forward (Alt+Right)" />
          <Button Style="{StaticResource Door}" x:Name="ReloadDoor" AutomationProperties.AutomationId="ReloadDoor" Content="&#xE72C;" FontSize="10" Click="Reload_Click" ToolTip="Reload (Ctrl+R)" />
        </StackPanel>
      </Grid>

      <!-- Pins: squares, four to a line. -->
      <Border x:Name="PinDrop" DockPanel.Dock="Top" Height="34" Margin="10,0,10,8" CornerRadius="9" Visibility="Collapsed"
              BorderThickness="1" BorderBrush="{DynamicResource Hairline}" Background="{DynamicResource Row.Tile}"
              AllowDrop="True" Drop="PinDrop_Drop">
        <TextBlock Text="Drop here to pin" FontSize="12" Foreground="{DynamicResource Row.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ItemsControl x:Name="PinGrid" DockPanel.Dock="Top" Margin="8,0,8,6" ItemTemplate="{StaticResource PinTile}"
                    AllowDrop="True" Drop="PinDrop_Drop" Background="Transparent">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- The foot of the column: home, downloads, bookmarks. -->
      <Grid DockPanel.Dock="Bottom" Margin="10,0,10,8" Height="30">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Door}" Content="&#xE80F;" ToolTip="Home" Click="Home_Click" />
        <Button Style="{StaticResource Door}" x:Name="DownloadsDoor" Content="&#xE896;" ToolTip="Downloads (Ctrl+Shift+J)" Click="DownloadsDoor_Click" />
        <Grid>
          <Button Style="{StaticResource Door}" x:Name="LibraryDoor" AutomationProperties.AutomationId="LibraryDoor" AutomationProperties.Name="Library" Content="&#xE8F1;" ToolTip="Library: spaces, history, downloads, bookmarks (Ctrl+Shift+L)" Click="LibraryDoor_Click" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform><RotateTransform x:Name="LibraryTilt" /></Button.RenderTransform>
          </Button>
          <Ellipse x:Name="LibraryBadge" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Visibility="Collapsed" IsHitTestVisible="False" Fill="{DynamicResource Ink}">
            <Ellipse.RenderTransform><TranslateTransform x:Name="LibraryBadgeDrop" /></Ellipse.RenderTransform>
          </Ellipse>
        </Grid>
        <Button Style="{StaticResource Door}" x:Name="ProfileDoor" AutomationProperties.AutomationId="ProfileDoor" Content="&#xE77B;" ToolTip="Profiles" Click="ProfileDoor_Click" Visibility="Collapsed" />
      </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Door}" x:Name="FootUpdateDoor" AutomationProperties.AutomationId="FootUpdate" AutomationProperties.Name="Restart to update" Content="&#xE895;" ToolTip="Restart to Update" Click="TopUpdate_Click" Visibility="Collapsed" />
          <Button Style="{StaticResource Door}" x:Name="FootSettingsDoor" AutomationProperties.AutomationId="FootSettings" AutomationProperties.Name="Settings" Content="&#xE713;" ToolTip="Settings (Ctrl+,)" Margin="0" Click="FootSettings_Click" />
        </StackPanel>
      </Grid>
      <!-- Spaces: one icon each, above the foot. Shown once spaces are turned on in Settings › Tabs. -->
      <WrapPanel x:Name="SpaceStrip" DockPanel.Dock="Bottom" Margin="10,0,10,4" Visibility="Collapsed" />
      <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="10,0,10,10">
        <StackPanel>
          <ItemsControl x:Name="TabList" ItemTemplate="{StaticResource TabRow}" AllowDrop="True" />
          <!-- New tab: the faintest ink, a plus and its name. -->
          <Border x:Name="NewTabRow" Height="28" CornerRadius="9" Background="Transparent" Cursor="Arrow" MouseLeftButtonUp="NewTab_Click">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
              <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyphs}" FontSize="10" Width="15" Margin="0,0,8,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Row.Faint}" TextAlignment="Center" />
              <TextBlock Text="New tab" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource Row.Faint}" />
            </StackPanel>
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Row.Hover}" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- The Library: the column widened, a rail of sections down its left, the section beside it. -->
    <Grid x:Name="LibraryHost" Grid.Column="0" Grid.RowSpan="3" Margin="0,52,0,0" Background="{DynamicResource Frame}" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel x:Name="LibraryRail" Margin="8,2,0,0" />
      <Border x:Name="LibraryFrame" Grid.Column="1" Margin="0,0,8,0" CornerRadius="10" Background="{DynamicResource Ground}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0.5" ClipToBounds="True" />
      <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="10,6,10,8" Height="30">
        <Button Style="{StaticResource Door}" AutomationProperties.AutomationId="LibraryBack" AutomationProperties.Name="Back to tabs" Content="&#xE72B;" HorizontalAlignment="Left" Click="LibraryBack_Click" ToolTip="Back to tabs (Esc)" />
        <TextBlock x:Name="LibraryTitle" AutomationProperties.AutomationId="LibraryTitle" FontSize="12.5" Margin="40,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Row.Muted}" />
        <Button Style="{StaticResource Door}" AutomationProperties.AutomationId="LibraryTab" AutomationProperties.Name="Open in a tab" Content="&#xE8A7;" HorizontalAlignment="Right" Margin="0" Click="LibraryTab_Click" ToolTip="Open in a tab" />
      </Grid>
    </Grid>

    <!-- The column's edge, dragged to make it wider (176 to 440, as on the Mac). -->
    <Thumb Grid.Column="0" Grid.RowSpan="3" HorizontalAlignment="Right" Width="6" Margin="0,52,-3,0" Cursor="SizeWE"
           DragDelta="SideEdge_DragDelta" DragCompleted="SideEdge_DragCompleted" Opacity="0">
      <Thumb.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
    </Thumb>

    <!-- While the column is hidden, its edge: the pointer there brings it back for as long as it stays. -->
    <Border x:Name="EdgeHot" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="3" HorizontalAlignment="Left" Width="8" Background="Transparent" Visibility="Collapsed" MouseEnter="EdgeHot_MouseEnter" />

    <!-- The page's card: 8 from the window's edges, corners of 10. -->
    <!-- The bookmarks bar: loose bookmarks as chips, folders as menus. -->
    <Border x:Name="BarHost" Grid.Column="1" Grid.Row="1" Margin="0,8,8,0" Height="28" Visibility="Collapsed">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="BarItems" Orientation="Horizontal" />
      </ScrollViewer>
    </Border>

    <!-- The card's shadow, drawn by a sibling: an effect on the card itself would re-render the page's host every frame. -->
    <Border x:Name="CardShadow" Grid.Column="1" Grid.Row="2" Margin="{Binding Margin, ElementName=Card}" CornerRadius="10" Background="{DynamicResource Ground}">
      <Border.Effect>
        <DropShadowEffect Color="Black" Opacity="0.07" BlurRadius="6" ShadowDepth="1" Direction="270" />
      </Border.Effect>
    </Border>
    <Border x:Name="Card" Grid.Column="1" Grid.Row="2" Margin="0,8,8,8" CornerRadius="10" Background="{DynamicResource Ground}"
            BorderBrush="{DynamicResource Hairline}" BorderThickness="0.5">
      <Grid>
        <Grid x:Name="Stage" />

        <!-- An empty tab: the field alone in the middle of the page (Omnibox.swift). -->
        <Grid x:Name="Blank" Background="{DynamicResource Ground}" Visibility="Collapsed">
          <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="560" Margin="24,0">
            <Border x:Name="FieldSheet" Style="{StaticResource Sheet}" Padding="22,14" VerticalAlignment="Top">
              <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.06" BlurRadius="24" ShadowDepth="8" Direction="270" />
              </Border.Effect>
              <Grid Height="22">
                <TextBlock x:Name="Placeholder" Text="Enter a web address" FontSize="15.5" Foreground="{DynamicResource Muted}" Opacity="0.75"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBox x:Name="BlankField" FontSize="15.5" BorderThickness="0" Background="Transparent" Padding="-2,0,0,0"
                         Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" VerticalContentAlignment="Center"
                         PreviewKeyDown="BlankField_PreviewKeyDown" TextChanged="BlankField_TextChanged" />
              </Grid>
            </Border>
            <Canvas VerticalAlignment="Top" Margin="0,58,0,0">
              <Border x:Name="BlankOffersSheet" Style="{StaticResource Sheet}" Padding="6" Width="560" Visibility="Collapsed" Margin="0,8,0,0" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                <Border.Effect>
                  <DropShadowEffect Color="Black" Opacity="0.07" BlurRadius="20" ShadowDepth="6" Direction="270" />
                </Border.Effect>
                <ListBox x:Name="BlankOffers" Style="{StaticResource OfferList}" />
              </Border>
            </Canvas>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- Find on page (Ctrl+F): over the card's top right. A popup, so it can lie over the page's own window. -->
    <Popup x:Name="FindPopup" AllowsTransparency="True" Placement="Relative" PlacementTarget="{Binding ElementName=Card}" StaysOpen="True" PopupAnimation="Fade">
      <Border Style="{StaticResource Sheet}" Margin="12,6,18,22" Padding="10,6" CornerRadius="12">
        <Border.Effect><DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="18" ShadowDepth="5" Direction="270" /></Border.Effect>
        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="FindBox" Width="190" FontSize="13" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}"
                   CaretBrush="{DynamicResource Ink}" VerticalContentAlignment="Center" Height="26" TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown" />
          <TextBlock x:Name="FindCount" AutomationProperties.AutomationId="FindCount" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="4,0,8,0" MinWidth="42" TextAlignment="Right" />
          <Button Style="{StaticResource Door}" Content="&#xE70E;" ToolTip="Previous (Shift+Enter)" Click="FindPrev_Click" />
          <Button Style="{StaticResource Door}" Content="&#xE70D;" ToolTip="Next (Enter)" Click="FindNext_Click" />
          <Button Style="{StaticResource Door}" Content="&#xE8BB;" FontSize="9" ToolTip="Close (Esc)" Click="FindClose_Click" Margin="0" />
        </StackPanel>
      </Border>
    </Popup>

    <!-- Add this page to bookmarks (Ctrl+Shift+B): a card to name it as you add it. -->
    <Popup x:Name="MarkPopup" AllowsTransparency="True" Placement="Relative" PlacementTarget="{Binding ElementName=Card}" StaysOpen="False" PopupAnimation="Fade">
      <Border Style="{StaticResource Sheet}" Margin="12,6,18,22" Padding="14" Width="300" CornerRadius="12">
        <Border.Effect><DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="18" ShadowDepth="5" Direction="270" /></Border.Effect>
        <StackPanel>
          <TextBlock AutomationProperties.AutomationId="MarkTitle" Text="Bookmark added" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,10" />
          <TextBox x:Name="MarkName" FontSize="13" Height="30" Padding="8,0" VerticalContentAlignment="Center" Background="Transparent" Foreground="{DynamicResource Ink}"
                   BorderBrush="{DynamicResource Hairline}" CaretBrush="{DynamicResource Ink}" PreviewKeyDown="MarkName_PreviewKeyDown" />
          <ComboBox x:Name="MarkFolder" Height="30" Margin="0,8,0,0" DisplayMemberPath="Name" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Remove" Padding="12,0" Height="28" Margin="0,0,6,0" Click="MarkRemove_Click" />
            <Button Content="Done" Padding="16,0" Height="28" Click="MarkDone_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Downloads, floating by their door (DownloadsFloat.swift). -->
    <Popup x:Name="DownloadsPopup" AllowsTransparency="True" Placement="Top" PlacementTarget="{Binding ElementName=DownloadsDoor}" StaysOpen="False" PopupAnimation="Fade">
      <Border Style="{StaticResource Sheet}" Margin="10,10,16,10" Padding="6" Width="320" CornerRadius="12">
        <Border.Effect><DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="18" ShadowDepth="5" Direction="270" /></Border.Effect>
        <StackPanel>
          <TextBlock x:Name="DownloadsNone" Text="Nothing downloaded yet." FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="10,10" />
          <ItemsControl x:Name="DownloadList" MaxHeight="320">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:DownloadItem}">
                <Border CornerRadius="9" Padding="10,7" Margin="0,0,0,2" Background="Transparent" x:Name="Item">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Line}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                      <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="3" Margin="0,5,0,0" Background="{DynamicResource Hairline}"
                                   Foreground="{DynamicResource Ink}" BorderThickness="0" Visibility="{Binding InProgress, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource Door}" Content="&#xE8E5;" ToolTip="Open" Click="DownloadOpen_Click" Visibility="{Binding CanOpen, Converter={StaticResource Visible}}" />
                      <Button Style="{StaticResource Door}" Content="&#xE838;" ToolTip="Show in folder" Click="DownloadShow_Click" Visibility="{Binding CanOpen, Converter={StaticResource Visible}}" />
                      <Button Style="{StaticResource Door}" Content="&#xE711;" FontSize="9" ToolTip="Cancel" Click="DownloadCancel_Click" Visibility="{Binding InProgress, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Show all downloads" Height="28" Margin="4,6,4,2" Click="DownloadsAll_Click" />
        </StackPanel>
      </Border>
    </Popup>

    <!-- Suggestions while editing a page's address in its row: a popup, so it can lie over the page. -->
    <Popup x:Name="InlinePopup" AllowsTransparency="True" Placement="Bottom" StaysOpen="True" PopupAnimation="Fade">
      <Border Style="{StaticResource Sheet}" Padding="6" Width="460" Margin="6,4,12,16">
        <Border.Effect>
          <DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="20" ShadowDepth="6" Direction="270" />
        </Border.Effect>
        <ListBox x:Name="InlineOffers" Style="{StaticResource OfferList}" />
      </Border>
    </Popup>
  </Grid>
</Window>
